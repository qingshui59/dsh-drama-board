{
  "name": "dsh-drama-board",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "映序 Studio：AI 短剧工作台。立项、角色定妆、分集、分镜出图、配音、图生视频，并在本机合成可发布的竖屏 MP4。",
  "license": "MIT",
  "homepage": "https://qingshui59.github.io/dsh-drama-board/",
  "repository": {
    "type": "git",
    "url": "https://github.com/qingshui59/dsh-drama-board.git"
  },
  "bugs": {
    "url": "https://github.com/qingshui59/dsh-drama-board/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs && node scripts/build-demo.mjs",
    "dev": "node scripts/build.mjs && node preview/server.mjs",
    "check": "node scripts/build.mjs && node --check client.js && node --check index.js && for f in host/*.js; do node --check \"$f\" || exit 1; done"
  }
}
